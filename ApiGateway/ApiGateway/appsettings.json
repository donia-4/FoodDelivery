{
    "AllowedHosts": "*",

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Ocelot": "Debug",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/apigateway-.txt",
                    "rollingInterval": "Day",
                    "rollOnFileSizeLimit": true
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName"
        ],
        "Properties": {
            "ApplicationName": "ApiGateway"
        }
    },
    "Identity": {
        "AuthorityUrl": "https://identityservices.runasp.net",
        "ApiResourceName": "service.Api"
    },
    "Cors": {
        "AllowedOrigins": []
    }
}